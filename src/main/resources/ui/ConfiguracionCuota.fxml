<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="540"
           prefWidth="600"
           stylesheets="@../styles/configuracioncuota.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ui.ConfiguracionCuotaController">

    <children>

        <AnchorPane maxHeight="500"
                    maxWidth="520"
                    prefHeight="500"
                    prefWidth="520"
                    styleClass="card-container">

            <children>

                <VBox spacing="14"
                      AnchorPane.topAnchor="24"
                      AnchorPane.leftAnchor="24"
                      AnchorPane.rightAnchor="24"
                      AnchorPane.bottomAnchor="24">

                    <children>

                        <VBox spacing="4"
                              alignment="CENTER"
                              maxWidth="Infinity">
                            <children>
                                <Label text="⚙ Configuración de Cuota"
                                       styleClass="title-label"/>
                                <Label text="Actualiza el valor mensual del condominio"
                                       styleClass="subtitle-label"/>
                            </children>
                        </VBox>

                        <HBox spacing="14"
                              alignment="TOP_CENTER"
                              translateY="28">

                            <children>

                                <VBox spacing="14"
                                      prefWidth="300"
                                      prefHeight="345"
                                      styleClass="form-card">

                                    <children>

                                        <Label text="Fecha actual"
                                               styleClass="field-label"/>

                                        <DatePicker fx:id="dpFecha"
                                                    prefHeight="38"
                                                    styleClass="custom-date"
                                                    translateY="-8"/>

                                        <Label text="Cuota actual"
                                               styleClass="field-label"/>

                                        <TextField fx:id="txtCuotaActual"
                                                   editable="false"
                                                   prefHeight="38"
                                                   styleClass="custom-input"
                                                   translateY="-8"/>

                                        <Label text="Nueva cuota"
                                               styleClass="field-label"/>

                                        <TextField fx:id="txtNuevaCuota"
                                                   prefHeight="38"
                                                   styleClass="custom-input"
                                                   translateY="-8"/>

                                        <HBox spacing="10"
                                              alignment="CENTER">
                                            <children>
                                                <Button text="Guardar"
                                                        onAction="#guardarCuota"
                                                        prefWidth="95"
                                                        prefHeight="38"
                                                        styleClass="save-button"/>
                                                
                                                <Button text="Cancelar"
                                                        onAction="#cancelarCuota"
                                                        prefWidth="95"
                                                        prefHeight="38"
                                                        styleClass="cancel-button"/>
                                            </children>
                                        </HBox>

                                    </children>
                                </VBox>

                                <VBox spacing="10"
                                      prefWidth="145"
                                      prefHeight="180"
                                      alignment="CENTER"
                                      styleClass="info-card">
                                    <children>
                                        <Label text="🛈 Información"
                                               styleClass="info-title"/>
                                        <Label text="Los cambios se aplicarán automáticamente a partir de la fecha seleccionada."
                                               wrapText="true"
                                               textAlignment="CENTER"
                                               styleClass="info-text"/>
                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                    </children>
                </VBox>

            </children>
        </AnchorPane>

    </children>
</StackPane>
