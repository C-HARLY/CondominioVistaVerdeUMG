<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="700" style="-fx-background-color: #f4f6f5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.DashboardController">

    <children>

        <StackPane prefWidth="926.0" style="-fx-padding: 40;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0">

            <children>

                <AnchorPane prefHeight="450" prefWidth="500" style="-fx-background-color: white;                                    -fx-background-radius: 20;                                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 5);">

                    <children>

                        <VBox alignment="CENTER" spacing="20" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

                            <children>

                                <ImageView fitWidth="220" preserveRatio="true" smooth="true">

                                    <image>
                                        <Image url="@../images/logo.png" />
                                    </image>

                                </ImageView>

                                <Label style="-fx-font-size: 24px;                                               -fx-font-weight: bold;                                               -fx-text-fill: #1f2937;" text="¡Bienvenido!" />

                                <Label style="-fx-font-size: 15px;                                               -fx-text-fill: #6b7280;" text="Sistema Administrativo del Condominio" />

                                <Label fx:id="lblFecha" style="-fx-font-size: 14px;                                               -fx-text-fill: #2e7d32;" />

                            </children>

                        </VBox>

                    </children>

                </AnchorPane>

            </children>

        </StackPane>

    </children>

</AnchorPane>
