<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane style="-fx-background-color: #f4f6f5;"
           stylesheets="@../styles/CasasMorosas.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ui.CasaMorosaController">

    <children>

        <!-- ================= CARD PRINCIPAL ================= -->

        <AnchorPane maxHeight="520"
                    maxWidth="580"
                    prefHeight="520"
                    prefWidth="580"
                    styleClass="card-container">

            <children>

                <!-- ================= CONTENEDOR ================= -->

                <VBox spacing="28"
                      AnchorPane.topAnchor="30"
                      AnchorPane.leftAnchor="30"
                      AnchorPane.rightAnchor="30"
                      AnchorPane.bottomAnchor="30">

                    <children>

                        <!-- ================= HEADER ================= -->

                        <HBox alignment="CENTER_LEFT">

                            <children>

                                <!-- TITULOS -->

                                <VBox spacing="4"
                                      HBox.hgrow="ALWAYS">

                                    <children>

                                        <Label text="🚨 Casas Morosas"
                                               styleClass="title-label"/>

                                        <Label text="Listado de casas con pagos pendientes"
                                               styleClass="subtitle-label"/>

                                    </children>

                                </VBox>

                                <!-- BOTON PDF -->

                                <Button text="Exportar PDF"
                                        prefHeight="38"
                                        prefWidth="100"
                                        styleClass="export-button"/>

                            </children>

                        </HBox>

                        <!-- ================= FILTROS ================= -->

                        <HBox spacing="16"
                              alignment="TOP_LEFT">

                            <children>

                                <!-- AÑO -->

                                <VBox spacing="6">

                                    <children>

                                        <Label text="Año"
                                               styleClass="form-label"/>

                                        <ComboBox fx:id="comboAnios"
                                                  prefWidth="140"
                                                  prefHeight="38"
                                                  styleClass="custom-combo"/>

                                    </children>

                                </VBox>

                                <!-- MES -->

                                <VBox spacing="6">

                                    <children>

                                        <Label text="Mes"
                                               styleClass="form-label"/>

                                        <ComboBox fx:id="comboMeses"
                                                  prefWidth="140"
                                                  prefHeight="38"
                                                  styleClass="custom-combo"/>

                                    </children>

                                </VBox>

                            </children>

                        </HBox>

                        <!-- ================= TABLA ================= -->

                        <TableView fx:id="tablaMorosos"
                                   prefHeight="285"
                                   prefWidth="460"
                                   styleClass="custom-table">

                            <columns>

                                <TableColumn fx:id="colNumeroCasa"
                                             prefWidth="56"
                                             text="Casa" />

                                <TableColumn fx:id="colNombre"
                                             prefWidth="180"
                                             text="Propietario" />

                                <TableColumn fx:id="colTelefono"
                                             prefWidth="95"
                                             text="Teléfono" />

                                <TableColumn fx:id="colCorreo"
                                             prefWidth="170"
                                             text="Correo" />

                            </columns>

                        </TableView>

                    </children>

                </VBox>

            </children>

        </AnchorPane>

    </children>

</StackPane>