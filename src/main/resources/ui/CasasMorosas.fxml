<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane style="-fx-background-color: #f4f6f5;" stylesheets="@../styles/CasasMorosas.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.CasaMorosaController">

    <children>

        <!-- ================= CARD PRINCIPAL ================= -->

        <AnchorPane maxHeight="520" maxWidth="580" prefHeight="520" prefWidth="580" styleClass="card-container">

            <children>

                <!-- ================= CONTENEDOR ================= -->

                <VBox spacing="28" AnchorPane.bottomAnchor="30" AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30" AnchorPane.topAnchor="30">

                    <children>

                        <!-- ================= HEADER ================= -->

                        <HBox alignment="CENTER_LEFT">

                            <children>

                                <!-- TITULOS -->

                                <VBox spacing="4" HBox.hgrow="ALWAYS">

                                    <children>

                                        <Label styleClass="title-label" text="🚨 Casas Morosas" />

                                        <Label styleClass="subtitle-label" text="Listado de casas con pagos pendientes" />

                                    </children>

                                </VBox>

                            </children>

                        </HBox>

                        <!-- ================= FILTROS ================= -->

                        <HBox alignment="TOP_LEFT" spacing="16">

                            <children>

                                <!-- AÑO -->

                                <VBox spacing="6">

                                    <children>

                                        <Label styleClass="form-label" text="Año" />

                                        <ComboBox fx:id="comboAnios" prefHeight="38" prefWidth="140" styleClass="custom-combo" />

                                    </children>

                                </VBox>

                                <!-- MES -->

                                <VBox spacing="6">

                                    <children>

                                        <Label styleClass="form-label" text="Mes" />

                                        <ComboBox fx:id="comboMeses" prefHeight="38" prefWidth="140" styleClass="custom-combo" />

                                    </children>

                                </VBox>

                            </children>

                        </HBox>

                        <!-- ================= TABLA ================= -->

                        <TableView fx:id="tablaMorosos" prefHeight="285" prefWidth="460" styleClass="custom-table">

                            <columns>

                                <TableColumn fx:id="colNumeroCasa" prefWidth="56" text="Casa" />

                                <TableColumn fx:id="colNombre" prefWidth="180" text="Propietario" />

                                <TableColumn fx:id="colTelefono" prefWidth="95" text="Teléfono" />

                                <TableColumn fx:id="colCorreo" prefWidth="170" text="Correo" />

                            </columns>

                        </TableView>

                    </children>

                </VBox>

            </children>

        </AnchorPane>

    </children>

</StackPane>
