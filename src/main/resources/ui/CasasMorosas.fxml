<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
    style="-fx-background-color: #f0f2f1;"
    stylesheets="@../styles/CasasMorosas.css"
    xmlns="http://javafx.com/javafx/26"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="ui.CasaMorosaController">

   <children>
      <VBox
          spacing="16"
          maxWidth="520"
          maxHeight="500"
          style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.13), 20, 0, 0, 4); -fx-padding: 30;"
          StackPane.alignment="CENTER">

         <children>

            <VBox spacing="4">
               <children>
                  <Label text="🚨 Casas Morosas"
                         style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                  <Label text="Listado de casas con pagos pendientes"
                         style="-fx-font-size: 13px; -fx-text-fill: #888888;" />
               </children>
            </VBox>

            <HBox spacing="24" alignment="CENTER_LEFT">
               <children>
                  <VBox spacing="5">
                     <children>
                        <Label text="Seleccione un año"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #444;" />
                        <ComboBox fx:id="comboAnios"
                                  prefWidth="150" prefHeight="36"
                                  style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;" />
                     </children>
                  </VBox>
                  <VBox spacing="5">
                     <children>
                        <Label text="Seleccione un mes"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #444;" />
                        <ComboBox fx:id="comboMeses"
                                  prefWidth="150" prefHeight="36"
                                  style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <TableView fx:id="tablaMorosos"
                       prefHeight="260"
                       prefWidth="460"
                       styleClass="custom-table">
               <columns>
                  <TableColumn fx:id="colNumeroCasa" prefWidth="68"  text="No. Casa" />
                  <TableColumn fx:id="colNombre"     prefWidth="175" text="Nombre del propietario" />
                  <TableColumn fx:id="colTelefono"   prefWidth="98"  text="Teléfono" />
                  <TableColumn fx:id="colCorreo"     prefWidth="119" text="Correo" />
               </columns>
            </TableView>

            <Button mnemonicParsing="false"
                    text="Generar Reporte"
                    style="-fx-background-color: #1B5E20; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 9 22 9 22; -fx-cursor: hand;" />

         </children>
      </VBox>
   </children>
</StackPane>