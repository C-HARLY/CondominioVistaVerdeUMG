<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane style="-fx-background-color: #f4f6f5;"
           stylesheets="@../styles/pago.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ui.PagoController">

    <children>

        <!-- CARD PRINCIPAL -->

        <AnchorPane maxHeight="500"
                    maxWidth="520"
                    prefHeight="520"
                    prefWidth="500"
                    styleClass="card-container">

            <children>

                <!-- CONTENEDOR PRINCIPAL -->

                <VBox alignment="TOP_CENTER"
                      spacing="18"
                      AnchorPane.topAnchor="35"
                      AnchorPane.leftAnchor="35"
                      AnchorPane.rightAnchor="35"
                      AnchorPane.bottomAnchor="35">

                    <children>

                        <!-- HEADER -->

                        <VBox spacing="4"
                              alignment="CENTER"
                              maxWidth="Infinity">

                            <children>

                                <Label text="💳 Registro de Pago"
                                       styleClass="title-label" />

                                <Label text="Administra pagos de cuotas del condominio"
                                       styleClass="subtitle-label" />

                            </children>

                        </VBox>

                        <!-- FORMULARIO -->

                        <GridPane hgap="18"
                                  vgap="16"
                                  style="-fx-padding: 20 0 0 0;">

                            <children>

                                <!-- CASA -->

                                <Label text="Número de casa"
                                       styleClass="form-label"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="0" />

                                <ComboBox fx:id="cmbCasas"
                                          prefWidth="200"
                                          prefHeight="41"
                                          styleClass="input"
                                          GridPane.columnIndex="1"
                                          GridPane.rowIndex="0" />

                                <!-- MES -->

                                <Label text="Mes"
                                       styleClass="form-label"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="1" />

                                <ComboBox fx:id="cmbMes"
                                          prefWidth="200"
                                          prefHeight="41"
                                          styleClass="input"
                                          GridPane.columnIndex="1"
                                          GridPane.rowIndex="1" />

                                <!-- AÑO -->

                                <Label text="Año"
                                       styleClass="form-label"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="2" />

                                <ComboBox fx:id="cmbYear"
                                          prefWidth="200"
                                          prefHeight="41"
                                          styleClass="input"
                                          GridPane.columnIndex="1"
                                          GridPane.rowIndex="2" />

                                <!-- MONTO -->

                                <Label text="Monto"
                                       styleClass="form-label"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="3" />

                                <TextField fx:id="txtMonto"
                                           prefWidth="200"
                                           prefHeight="41"
                                           styleClass="input"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="3" />

                            </children>

                            <!-- COLUMNAS -->

                            <columnConstraints>

                                <ColumnConstraints />

                                <ColumnConstraints />

                            </columnConstraints>

                            <!-- FILAS -->

                            <rowConstraints>

                                <RowConstraints />

                                <RowConstraints />

                                <RowConstraints />

                                <RowConstraints />

                            </rowConstraints>

                        </GridPane>

                        <!-- BOTON -->

                        <Button text="Registrar"
                                prefWidth="100"
                                styleClass="primary-button"
                                onAction="#registrarPago">

                            <VBox.margin>

                                <Insets top="20" />

                            </VBox.margin>

                        </Button>

                    </children>

                </VBox>

            </children>

        </AnchorPane>

    </children>

</StackPane>