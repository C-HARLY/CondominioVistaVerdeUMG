<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0"
            prefWidth="950.0"
            style="-fx-background-color: #f4f6f5;"
            stylesheets="@../styles/menu.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.MenuPrincipalController">

    <!-- ================= SIDEBAR ================= -->

    <left>

        <VBox prefWidth="250"
              spacing="18"
              style="-fx-background-color: white;
                     -fx-padding: 25;
                     -fx-background-radius: 0 20 20 0;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 3, 0);">

            <children>

                <!-- HEADER -->

                <VBox spacing="4">

                    <children>

                        <Label text="Menú Principal"
                               style="-fx-font-size: 22px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #000000;" />

                    </children>

                </VBox>

                <Separator />

                <!-- ================= GESTIÓN ================= -->

                <Label text="GESTIÓN ADMINISTRATIVA"
                       style="-fx-text-fill: #9ca3af;
                              -fx-font-size: 11px;
                              -fx-font-weight: bold;" />

                <!-- PROPIETARIOS -->

                <Button fx:id="btnPropietarios"
                        text="👤  Propietarios"
                        prefHeight="45"
                        maxWidth="Infinity"
                        styleClass="menu-button" />

                <!-- PAGOS -->

                <Button fx:id="btnPagos"
                        text="💳  Pagos"
                        prefHeight="45"
                        maxWidth="Infinity"
                        styleClass="menu-button"
                        onAction="#abrirPagos" />

                <!-- CONFIGURACIÓN -->

                <Button text="⚙  Configuración de cuota"
                        prefHeight="45"
                        maxWidth="Infinity"
                        styleClass="menu-button" />

                <Separator />

                <!-- ================= REPORTES ================= -->

                <Label text="REPORTES Y CONTROL"
                       style="-fx-text-fill: #9ca3af;
                              -fx-font-size: 11px;
                              -fx-font-weight: bold;" />

                <!-- ESTADO DE CUENTA -->

                <Button fx:id="btnEstadoCuenta"
                        text="📄  Estado de cuenta"
                        prefHeight="45"
                        maxWidth="Infinity"
                        styleClass="menu-button"
                        onAction="#abrirEstadoCuenta" />

                <!-- REPORTE GENERAL -->

                <Button fx:id="btnReporte"
                        text="📊  Reporte general"
                        prefHeight="45"
                        maxWidth="Infinity"
                        styleClass="menu-button"
                        onAction="#abrirReporteGeneral" />

                <!-- MOROSOS -->

                <Button fx:id="btnMorosos"
                        text="🚨  Casas morosas"
                        prefHeight="45"
                        maxWidth="Infinity"
                        styleClass="menu-button" />

                <!-- ESPACIADOR -->

                <VBox prefHeight="200" />

                <!-- CERRAR SESIÓN -->

                <Button text="🚪  Cerrar sesión"
                        prefHeight="45"
                        maxWidth="Infinity"
                        styleClass="logout-button"
                        onMouseClicked="#cerrarSesion" />

            </children>

        </VBox>

    </left>

    <!-- ================= CONTENIDO DINÁMICO ================= -->

    <center>

        <AnchorPane fx:id="contentArea"
                    style="-fx-background-color: #f4f6f5;"
                    BorderPane.alignment="CENTER" />

    </center>

</BorderPane>
