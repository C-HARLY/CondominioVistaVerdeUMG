<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    prefHeight="600.0"
    prefWidth="950.0"
    style="-fx-background-color: #f4f6f5;"
    stylesheets="@../styles/menu.css"
    xmlns="http://javafx.com/javafx/26"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="ui.MenuPrincipalController">

    <!-- ================= SIDEBAR ================= -->

    <left>

        <VBox
            prefWidth="250"
            spacing="18"
            style="
                -fx-background-color: white;
                -fx-padding: 25;
                -fx-background-radius: 0 20 20 0;
                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 3, 0);
            ">

            <children>

                <!-- HEADER -->

                <VBox spacing="4">

                    <children>

                        <Label
                            text="Menú Principal"
                            style="
                                -fx-font-size: 22px;
                                -fx-font-weight: bold;
                                -fx-text-fill: #000000;
                            "/>
<!--
                        <Label
                            text="Administración"
                            style="
                                -fx-text-fill: #6b7280;
                                -fx-font-size: 13px;
                            "/>
-->
                    </children>

                </VBox>

                <!-- SEPARADOR -->

                <Separator />

                <!-- GESTIÓN ADMINISTRATIVA -->

                <Label
                    text="Gestion Administrativa"
                    style="
                        -fx-text-fill: #9ca3af;
                        -fx-font-size: 11px;
                        -fx-font-weight: bold;
                    "/>

                <Button
                    text="👤  Propietarios"
                    prefHeight="45"
                    maxWidth="Infinity"
                    styleClass="menu-button-active"/>

                <Button
                    text="💳  Pagos"
                    prefHeight="45"
                    maxWidth="Infinity"
                    styleClass="menu-button"/>

                <Button
                    text="⚙  Configuración de cuota"
                    prefHeight="45"
                    maxWidth="Infinity"
                    styleClass="menu-button"/>

                <!-- SEPARADOR -->

                <Separator />

                <!-- REPORTES Y CONTROL -->

                <Label
                    text="Reportes y Control"
                    style="
                        -fx-text-fill: #9ca3af;
                        -fx-font-size: 11px;
                        -fx-font-weight: bold;
                    "/>

                <Button
                    text="📄  Estado de cuenta"
                    prefHeight="45"
                    maxWidth="Infinity"
                    styleClass="menu-button"/>

                <Button
                    text="📊  Reporte general"
                    prefHeight="45"
                    maxWidth="Infinity"
                    styleClass="menu-button"/>

                <Button
                    text="🚨  Casas morosas"
                    prefHeight="45"
                    maxWidth="Infinity"
                    styleClass="menu-button"/>

                <!-- ESPACIADOR -->

                <VBox prefHeight="200"/>

                <!-- SISTEMA -->

                <Button
                    text="🚪  Cerrar sesión"
                    prefHeight="45"
                    maxWidth="Infinity"
                    onMouseClicked="#cerrarSesion"
                    styleClass="logout-button"/>

            </children>

        </VBox>

    </left>

    <!-- ================= CONTENIDO ================= -->

    <center>

        <StackPane style="-fx-padding: 40;">

            <children>

                <!-- CARD PRINCIPAL -->

                <AnchorPane
                    prefHeight="450"
                    prefWidth="500"
                    style="
                        -fx-background-color: white;
                        -fx-background-radius: 20;
                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 5);
                    ">

                    <children>

                        <VBox
                            alignment="CENTER"
                            spacing="20"
                            AnchorPane.topAnchor="0"
                            AnchorPane.bottomAnchor="0"
                            AnchorPane.leftAnchor="0"
                            AnchorPane.rightAnchor="0">

                            <children>

                                <!-- LOGO -->

                                <ImageView
                                    fitWidth="220"
                                    preserveRatio="true"
                                    smooth="true">

                                    <image>
                                        <Image url="@../images/logo.png"/>
                                    </image>

                                </ImageView>

                                <!-- TÍTULO -->

                                <Label
                                    text="¡Bienvenido!"
                                    style="
                                        -fx-font-size: 24px;
                                        -fx-font-weight: bold;
                                        -fx-text-fill: #1f2937;
                                    "/>

                                <!-- SUBTÍTULO -->

                                <Label
                                    text="Sistema Administrativo del Condominio"
                                    style="
                                        -fx-font-size: 15px;
                                        -fx-text-fill: #6b7280;
                                    "/>

                                <!-- FECHA -->

                                <Label
                                    fx:id="lblFecha"
                                    style="
                                        -fx-font-size: 14px;
                                        -fx-text-fill: #2e7d32;
                                    "/>

                            </children>

                        </VBox>

                    </children>

                </AnchorPane>

            </children>

        </StackPane>

    </center>

</BorderPane>