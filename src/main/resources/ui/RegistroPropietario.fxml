<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ui.RegistroPropietarioController"
           style="-fx-background-color: #f4f6f5;"
           stylesheets="@../styles/registropropietario.css">

    <children>

        <!-- CARD -->

        <AnchorPane prefWidth="520"
                    prefHeight="500"
                    maxWidth="520"
                    maxHeight="500"
                    styleClass="card-container">

            <children>

                <VBox alignment="TOP_CENTER"
                      spacing="18"
                      AnchorPane.topAnchor="35"
                      AnchorPane.leftAnchor="35"
                      AnchorPane.rightAnchor="35"
                      AnchorPane.bottomAnchor="35">

                    <children>

                        <!-- HEADER -->

                        <VBox spacing="4"
                              alignment="CENTER"
                              maxWidth="Infinity">

                            <children>

                                <Label text="👤 Registro de Propietario"
                                       styleClass="title-label"/>

                                <Label text="Administra propietarios del condominio"
                                       styleClass="subtitle-label"/>

                            </children>

                        </VBox>

                        <!-- FORMULARIO -->

                        <GridPane hgap="18"
                                  style="-fx-padding: 20 0 0 0;"
                                  vgap="16">

                            <children>

                                <!-- NOMBRE -->

                                <Label text="Nombre completo"
                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="0"
                                       styleClass="form-label"/>

                                <TextField fx:id="txtNombre"
                                           prefWidth="260"
                                           styleClass="input"
                                           GridPane.rowIndex="0"
                                           GridPane.columnIndex="1"/>

                                <!-- TELEFONO -->

                                <Label text="Teléfono"
                                       GridPane.rowIndex="1"
                                       GridPane.columnIndex="0"
                                       styleClass="form-label"/>

                                <TextField fx:id="txtTelefono"
                                           prefWidth="260"
                                           styleClass="input"
                                           GridPane.rowIndex="1"
                                           GridPane.columnIndex="1"/>

                                <!-- CORREO -->

                                <Label text="Correo electrónico"
                                       GridPane.rowIndex="2"
                                       GridPane.columnIndex="0"
                                       styleClass="form-label"/>

                                <TextField fx:id="txtCorreo"
                                           prefWidth="260"
                                           styleClass="input"
                                           GridPane.rowIndex="2"
                                           GridPane.columnIndex="1"/>

                                <!-- CASA -->

                                <Label text="Número de casa"
                                       GridPane.rowIndex="3"
                                       GridPane.columnIndex="0"
                                       styleClass="form-label"/>

                                <ComboBox fx:id="cmbCasas"
                                          prefWidth="260"
                                          styleClass="input"
                                          GridPane.rowIndex="3"
                                          GridPane.columnIndex="1"/>

                            </children>

                        </GridPane>

                        <!-- BOTON -->

                        <Button text="Registrar"
                                prefWidth="100"
                                onAction="#registrarPropietario"
                                styleClass="primary-button">

                            <VBox.margin>
                                <Insets top="20"/>
                            </VBox.margin>

                        </Button>

                    </children>

                </VBox>

            </children>

        </AnchorPane>

    </children>

</StackPane>