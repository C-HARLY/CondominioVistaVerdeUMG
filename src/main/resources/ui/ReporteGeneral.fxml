<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<StackPane style="-fx-background-color: #f4f6f5;"
           stylesheets="@../styles/reportegeneral.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ui.ReporteGeneralController">

    <children>

        <!-- CARD PRINCIPAL -->

        <AnchorPane maxHeight="500"
                    maxWidth="520"
                    prefHeight="520"
                    prefWidth="580"
                    styleClass="card-container">

            <children>

                <VBox spacing="34"
                      AnchorPane.bottomAnchor="28"
                      AnchorPane.leftAnchor="30"
                      AnchorPane.rightAnchor="30"
                      AnchorPane.topAnchor="28">

                    <children>

                        <!-- HEADER -->

                        <HBox alignment="TOP_LEFT">

                            <children>

                                <!-- TITULOS -->

                                <VBox spacing="4"
                                      HBox.hgrow="ALWAYS">

                                    <children>

                                        <Label styleClass="title-label"
                                               text="📊 Reporte General" />

                                        <Label styleClass="subtitle-label"
                                               text="Resumen financiero del condominio" />

                                    </children>

                                </VBox>

                                <!-- BOTON PDF -->

                                <Button fx:id="btnGenerarPDF"
                                        mnemonicParsing="false"
                                        onAction="#generarReportePDF"
                                        prefHeight="38"
                                        prefWidth="100"
                                        styleClass="pdf-button"
                                        text="Exportar PDF" />

                            </children>

                        </HBox>

                        <!-- FILTROS + RESUMEN -->

                        <HBox alignment="CENTER_LEFT"
                              maxWidth="520"
                              prefWidth="520"
                              spacing="16">

                            <children>

                                <!-- FILTRO MES -->

                                <VBox spacing="6"
                                      alignment="TOP_LEFT">

                                    <children>

                                                  <ComboBox fx:id="cmbMes"
                                                  onAction="#onCmbMesChange"
                                                  prefHeight="38"
                                                  prefWidth="132"
                                                  styleClass="custom-combo"/>

                                    </children>

                                </VBox>

                                <!-- TOTAL ESPERADO -->

                                <VBox alignment="CENTER"
                                      prefHeight="68"
                                      prefWidth="145"
                                      spacing="5"
                                      styleClass="summary-card">

                                    <children>

                                        <Label styleClass="summary-title"
                                               text="Total Esperado" />

                                        <Label fx:id="lblTotalEsperado"
                                               styleClass="summary-value"
                                               text="Q0.00" />

                                    </children>

                                </VBox>

                                <!-- TOTAL RECAUDADO -->

                                <VBox alignment="CENTER"
                                      prefHeight="68"
                                      prefWidth="145"
                                      spacing="5"
                                      styleClass="summary-card">

                                    <children>

                                        <Label styleClass="summary-title"
                                               text="Total Recaudado" />

                                        <Label fx:id="lblTotalRecaudado"
                                               styleClass="summary-value-green"
                                               text="Q0.00" />

                                    </children>

                                </VBox>

                            </children>

                        </HBox>

                        <!-- TABLA -->

                        <TableView fx:id="tblReporte"
                                   maxWidth="520"
                                   prefHeight="300"
                                   prefWidth="520"
                                   styleClass="custom-table">

                                   <VBox.margin>
                                        <Insets top="-10"/>
                                   </VBox.margin>
                            
                            
                            <columns>

                                <TableColumn fx:id="colCasa"
                                             prefWidth="56"
                                             text="Casa" />

                                <TableColumn fx:id="colPropietario"
                                             prefWidth="175"
                                             text="Propietario" />

                                <TableColumn fx:id="colEstado"
                                             prefWidth="90"
                                             text="Estado" />

                                <TableColumn fx:id="colMontoMes"
                                             prefWidth="90"
                                             text="Monto" />

                                <TableColumn fx:id="colTotal"
                                             prefWidth="90"
                                             text="Total" />

                            </columns>

                        </TableView>

                    </children>

                </VBox>

            </children>

        </AnchorPane>

    </children>

</StackPane>