<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane style="-fx-background-color: #f4f6f5;" stylesheets="@../styles/reportegeneral.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.ReporteGeneralController">

    <children>

        <!-- CARD PRINCIPAL -->

        <AnchorPane maxHeight="500" maxWidth="580" prefHeight="520" prefWidth="520" styleClass="card-container">

            <children>

                <VBox spacing="12" AnchorPane.bottomAnchor="28" AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30" AnchorPane.topAnchor="28">

                    <children>

                        <!-- HEADER -->

      <VBox spacing="10">

    <children>

        <!-- TITULO -->

        <Label styleClass="title-label" text="📊 Reporte General" />

        <!-- SUBTITULO -->

        <Label styleClass="subtitle-label" text="Resumen financiero del condominio" />

        <!-- FILTRO -->

        <HBox alignment="CENTER_LEFT" />

    </children>

</VBox>

<!-- MINI CARDS -->

<HBox maxWidth="520" prefWidth="520" spacing="20">

    <children>

                <ComboBox fx:id="cmbMes" prefHeight="37.0" prefWidth="133.0" styleClass="custom-combo" />

        <!-- TOTAL ESPERADO -->

        <VBox alignment="CENTER" prefHeight="68.0" prefWidth="150.0" spacing="6" styleClass="summary-card">

            <children>

                <Label styleClass="summary-title" text="Total Esperado" />

                <Label fx:id="lblTotalEsperado" styleClass="summary-value" text="Q0" />

            </children>

        </VBox>

        <!-- TOTAL RECAUDADO -->

        <VBox alignment="CENTER" prefHeight="68.0" prefWidth="150.0" spacing="6" styleClass="summary-card">

            <children>

                <Label styleClass="summary-title" text="Total Recaudado" />

                <Label fx:id="lblTotalRecaudado" styleClass="summary-value-green" text="Q0" />

            </children>

        </VBox>

    </children>

</HBox>

                        <!-- TABLA -->

                        <TableView fx:id="tablaReporte" maxWidth="520" prefHeight="276.0" prefWidth="460.0" styleClass="custom-table">

                             <columns>

                                 <TableColumn fx:id="colCasa" prefWidth="55" text="Casa" />

                                 <TableColumn fx:id="colPropietario" prefWidth="150" text="Propietario" />

                                 <TableColumn fx:id="colEstado" prefWidth="85" text="Estado" />

                                 <TableColumn fx:id="colMontoMes" prefWidth="95" text="Mes" />

                                 <TableColumn fx:id="colTotalAnio" prefWidth="95" text="Total" />

                             </columns>

                         </TableView>

                    </children>

                </VBox>

            </children>

        </AnchorPane>

    </children>

</StackPane>
